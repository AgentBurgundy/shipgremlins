# ShipGremlins: names only. Store values in your secret manager or CI settings.
# Dashboard connection keys load from .env automatically. Other keys require explicit loading.
# For all local settings: shipgremlins --env-file .env setup --check
GITHUB_TOKEN=
APP_ID=
APP_PRIVATE_KEY=
LINEAR_API_KEY=
VERCEL_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN=
# Trusted verifier configuration. The dispatcher gets only the Ed25519 public PEM.
SHIPGREMLINS_ATTESTATION_PUBLIC_KEY=
# Private PEM belongs only in a separate trusted signing job, never agent/build jobs.
SHIPGREMLINS_ATTESTATION_KEY=
SHIPGREMLINS_VERIFICATION_FILE=
# Current agent workflows require the Claude subscription token and reject ANTHROPIC_API_KEY.
# Non-secret overrides (optional):
# BOT_LOGIN=your-github-app[bot]
# SHIPGREMLINS_HOME=/absolute/path/to/your/private-hub-configuration
# APP_ID and APP_PRIVATE_KEY mint short-lived GitHub App tokens in CI.
# GITHUB_TOKEN is used by local CLI commands; do not commit an actual value here.
# setup init in a fresh directory adds the selected project's secret names:
# SLACK_WEBHOOK_YOUR_PROJECT=
# VERCEL_BYPASS_YOUR_PROJECT=
